---
import { render, type CollectionEntry } from "astro:content";
import { site } from "../data/site";
import { t } from "../data/ui";

interface Props {
	entry: CollectionEntry<"projects">;
	showBody?: boolean;
}

const { entry, showBody = false } = Astro.props;
const { title, client, role, startDate, endDate, tech, summary } = entry.data;

const monthYear = new Intl.DateTimeFormat(site.defaultLocale, {
	year: "numeric",
	month: "short",
});

const period = `${monthYear.format(startDate)} – ${endDate ? monthYear.format(endDate) : t.present}`;

const { Content } = showBody ? await render(entry) : { Content: null };
---

<article class="project">
	<h3>{title}</h3>
	<p class="meta">
		{client && <span>{client}</span>}
		<span>{role}</span>
		<span>{period}</span>
	</p>
	<p class="summary">{summary}</p>
	{
		Content && (
			<div class="body">
				<Content />
			</div>
		)
	}
	<ul class="tech">
		{tech.map((item) => <li>{item}</li>)}
	</ul>
</article>

<style>
	.project {
		padding: 1.375rem 1.375rem 1.125rem;
		margin-block-end: 1rem;
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: var(--radius);
		transition:
			border-color 140ms ease,
			background-color 140ms ease;
	}

	.project:hover {
		background: var(--surface-hover);
		border-color: color-mix(in srgb, var(--accent) 35%, var(--border));
	}

	.meta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.125rem 0.75rem;
		margin-block: 0 0.875rem;
		font-size: 0.8125rem;
		color: var(--muted);
	}

	.meta span + span::before {
		content: "·";
		margin-inline-end: 0.75rem;
		/* Tied to --muted rather than --border, which is too dark to see on the
		   card surface in the dark palette. */
		color: color-mix(in srgb, var(--muted) 50%, transparent);
	}

	.summary {
		margin-block-end: 0.875rem;
	}

	/* Rendered markdown body: keep it visually secondary to the summary. */
	.body {
		color: var(--muted);
		font-size: 0.9375rem;
	}

	.body :global(p:last-child) {
		margin-block-end: 0;
	}

	.tech {
		display: flex;
		flex-wrap: wrap;
		gap: 0.375rem;
		padding: 0;
		margin-block: 1rem 0;
		list-style: none;
		font-size: 0.75rem;
		letter-spacing: 0.01em;
	}

	.tech li {
		padding: 0.1875rem 0.5rem;
		color: var(--muted);
		background: var(--accent-dim);
		border: 1px solid var(--border);
		border-radius: 999px;
	}
</style>
