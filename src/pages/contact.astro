---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../data/site";
import { t } from "../data/ui";

const elsewhere = site.links.filter((link) => link !== site.contact);
---

<BaseLayout title={t.nav.contact} description={`How to reach ${site.name}.`}>
	<h1>{t.nav.contact}</h1>
	<p>
		{site.contact.label} is the best way to reach me. I read messages on weekdays
		and usually reply within a day or two. I work in both Finnish and English.
	</p>

	<p>
		I am open to new work — most interested in projects with modern
		implementations, and comfortable with the awkward device platforms and
		long-lived systems that show up in my project history.
	</p>

	<p>
		<a class="cta" href={site.contact.href}>{t.messageOn} {site.contact.label}</a>
	</p>

	{
		elsewhere.length > 0 && (
			<>
				<h2>{t.elsewhere}</h2>
				<ul class="links">
					{elsewhere.map(({ href, label }) => (
						<li>
							<a href={href}>{label}</a>
						</li>
					))}
				</ul>
			</>
		)
	}
</BaseLayout>

<style>
	.cta {
		display: inline-block;
		margin-block-start: 0.5rem;
		padding: 0.625rem 1.125rem;
		color: var(--bg);
		background: var(--accent);
		border-radius: 999px;
		font-weight: 600;
		text-decoration: none;
		transition: background-color 140ms ease;
	}

	.cta:hover {
		color: var(--bg);
		background: var(--accent-strong);
	}

	.links {
		padding: 0;
		margin: 0;
		list-style: none;
	}

	.links li + li {
		margin-block-start: 0.375rem;
	}
</style>
